{
  "expo": {
    "name": "Köpa köpa köpa",
    "slug": "grocery-list",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grocerylist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.erikfriberg.lista",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Köpa köpa köpa needs access to your photo library to let you select a photo of a recipe or grocery list. For example, you can pick a photo of a recipe page and the app will read the ingredients and automatically add them as items to your shopping list.",
        "NSCameraUsageDescription": "Köpa köpa köpa needs access to your camera to let you take a photo of a recipe or handwritten grocery list. For example, you can photograph a cookbook page and the app will read the ingredients and automatically add them as items to your shopping list."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d036ef63-e075-4d96-b2b6-d05e4c5e0a80"
      }
    }
  }
}
